AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
# Paste only the client secret Value from Entra, without its label, secret ID, or expiry.
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Postgres URL, used server-side by the Next.js API routes directly.
# Use the Supabase pooler URL and keep sslmode=require.
DATABASE_URL=

# Local dev only: adds a "local dev sign-in" button that skips Microsoft Entra.
# Never set this in a deployed environment; the app ignores it outside `next dev`.
DEV_AUTH_BYPASS=true
DEV_AUTH_BYPASS_USER_ID=00000000-0000-0000-0000-000000000001
